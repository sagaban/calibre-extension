{
  "manifest_version": 3,
  "name": "Send to Calibre",
  "version": "1.0.0",
  "description": "Convierte la página actual en EPUB y la agrega a tu biblioteca de Calibre (Content Server).",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Enviar a Calibre",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "options_ui": { "page": "options/options.html", "open_in_tab": false },
  "commands": {
    "send-page": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Enviar la página actual a Calibre"
    }
  }
}
